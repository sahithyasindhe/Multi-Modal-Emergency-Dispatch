# SENTINEL-911 Environment Configuration
# Copy to .env and fill in values as needed.
# Demo mode works with empty API keys.

APP_ENV=development
MODEL_MODE=demo
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
DATABASE_URL=sqlite:///./data/sentinel.db
CHROMA_PATH=./data/chroma
PROTOCOLS_PATH=./data/protocols
LOG_LEVEL=INFO
LOG_RAW_AUDIO=false
PERSIST_INCIDENTS=true
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*
DEDUP_TIME_WINDOW_MINUTES=10
DEDUP_DISTANCE_METERS=250
DEDUP_SIMILARITY_THRESHOLD=0.75
MAX_REVISION_ATTEMPTS=2
RAG_TOP_K=5
RAG_MIN_SCORE=0.15
